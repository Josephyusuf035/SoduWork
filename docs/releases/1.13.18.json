    "en-US": {
      "summary": "This update improves per-directory model choices, conversational automation and plugin authoring, with fixes for conversation recovery, execution queues and requirement delivery.",
      "sections": [
        {
          "id": "features",
          "title": "Feature updates",
          "items": [
            {
              "id": "directory-preferences",
              "text": "Remember the runtime and model successfully used in each working directory, restore available pairs for new conversations there, and retain selections through authentication refreshes and cloud switching."
            },
            {
              "id": "automation-drafts",
              "text": "Automation drafts support relative times such as “in five minutes” and conversational edits, confirmation or cancellation. Ambiguous times stay as drafts. Templates support effective dates and detect stale edits before overwriting newer settings."
            },
            {
              "id": "skill-discovery",
              "text": "The skills page now includes a discovery entry for recommended public skill sources, with guidance to import them through Add Skill."
            }
          ]
        },
        {
          "id": "fixes",
          "title": "Bug fixes",
          "items": [
            {
              "id": "sign-in-recovery",
              "text": "Fix brief sign-in forms and account or language flicker during session recovery. Remember accounts per Hub and preserve authenticated workspace recovery and saved display preferences."
            },
            {
              "id": "workspace-history",
              "text": "Fix duplicate cloud conversations, leftover caches after deletion, and repeated launches failing to restore the workspace. Improve drops onto empty projects and long-list collapsing, and stop pet dragging when mouse release is lost."
            },
            {
              "id": "runtime-goals",
              "text": "Ordinary conversations no longer enter goal loops based on message wording. Preserve runtime history and goal pause/resume state. Improve DeepSeek child-task waiting, retained tool results and Codex reconnect notices so unfinished work is not mistaken for completion."
            },
            {
              "id": "runner-queue",
              "text": "Execution status now distinguishes queued, starting and running work, with queue position and wait time. Fix cancellation and status interference between concurrent sessions, along with certain execution-event and model-connection cleanup failures."
            },
            {
              "id": "plugin-authoring",
              "text": "The plugin development assistant treats requests as reusable plugin authoring and offers installation only after package checks pass. Fix stuck running states after draft checks fail, lost repair-error details and unclear icon-upload feedback."
            },
            {
              "id": "requirement-delivery",
              "text": "Fix requirements failing to reach review after completion, missing delivery attachments and intermediate drafts entering final deliverables. Distinguish pending sync, manual submission and blocked delivery, preserve legacy task text, and reduce duplicate requirement-card actions."
            },
            {
              "id": "files-preview",
              "text": "Fix opening empty library files and some video-preview range requests. Preserve single tildes in Markdown so numeric ranges are not incorrectly rendered as strikethrough."
            },
            {
              "id": "model-settings",
              "text": "Eligible OpenAI-compatible services automatically check capabilities after new chat models are saved. Improve capability results and image routing, separate model saves from service saves, and clarify output-token errors and multilingual model-page layout."
            },
            {
              "id": "access-controls",
              "text": "New conversations default to standard access. Restore configured tools when leaving read-only access, and validate repository-relative paths to prevent work outside allowed directories."
            },
            {
              "id": "application-tabs",
              "text": "Open new application pages as tabs and handle invalid origins during page restoration. Application delivery notices now distinguish completed checks from items still requiring manual confirmation."
            },
            {
              "id": "localized-interface",
              "text": "Improve translations for requirement drafts, assignments, offline sign-in and Korean agent pages. Preserve assignment names across language changes, and fix oversized runtime icons and dialogs overlapping the title bar."
            },
            {
              "id": "admin-diagnostics",
              "text": "Improve diagnostics for unpaired WeCom messages and model refusals. Prevent stale admin responses after account changes, and fix user-form autofill, legacy domain ordering and MCP conflict-refresh error feedback."
            },
            {
              "id": "installation",
              "text": "Linux installers now include signatures and verification files, with embedded RPM signatures. Windows uninstall explains when administrator privileges are needed to retry data cleanup."
            },
            {
              "id": "source-startup",
              "text": "For source launches, place default dependency caches and temporary files under the selected data directory. Fix startup failures caused by invalid environment paths and distinguish disk-space failures from runtime-check problems."
            },
            {
              "id": "system-certificate-trust",
              "text": "Runner model and control connections use operating-system certificate trust to fix certificate-chain failures in affected environments while respecting explicit certificate settings."
            }
          ]
        }
      ]
    },
